@page "/"
@using System.Net.Http
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json

<PageTitle>Nanoleaf Controller</PageTitle>

<h1>Nanoleaf Controller</h1>

<button class="btn btn-primary" @onclick="TurnOn">Turn On</button>
<button class="btn btn-secondary" @onclick="TurnOff">Turn Off</button>

@code {
    private async Task TurnOn()
    {
        await SendPowerCommand(true);
    }

    private async Task TurnOff()
    {
        await SendPowerCommand(false);
    }

    private async Task SendPowerCommand(bool on)
    {
        var nanoleafIp = "YOUR_NANOLEAF_IP"; // <-- IMPORTANT: REPLACE WITH YOUR NANOLEAF IP
        var authToken = "YOUR_AUTH_TOKEN"; // <-- IMPORTANT: REPLACE WITH YOUR AUTH TOKEN
        var client = new HttpClient();
        var url = $"http://{nanoleafIp}:16021/api/v1/{authToken}/state";
        var body = new { on = new { value = on } };
        var content = new StringContent(JsonSerializer.Serialize(body), Encoding.UTF8, "application/json");

        try
        {
            var response = await client.PutAsync(url, content);
            response.EnsureSuccessStatusCode();
            Console.WriteLine($"Nanoleaf turned {(on ? "on" : "off")} successfully.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error controlling Nanoleaf: {ex.Message}");
        }
    }
}
