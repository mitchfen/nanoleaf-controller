@page "/"
@rendermode InteractiveServer
@using System.Net.Http
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json


<PageTitle>Nanoleaf Controller</PageTitle>

<h1>Nanoleaf Controller</h1>

<button @onclick="() => SendPowerCommand(true)">Turn On</button>
<button @onclick="() => SendPowerCommand(false)">Turn Off</button>

<div class="d-flex align-items-center my-3">
    <label for="brightness" class="form-label me-2 mb-0">Brightness:</label>
    <input type="range" class="form-range" min="0" max="100" id="brightness" @bind="brightness" @bind:event="oninput" />
    <span class="ms-2" style="width: 40px;">@brightness%</span>
</div>
<button class="btn btn-primary" @onclick="SetBrightness">Set Brightness</button>

<div class="d-flex align-items-center my-3">
    <label for="effect" class="form-label me-2 mb-0">Effect:</label>
    <select class="form-select" id="effect" @bind="selectedEffect">
        @foreach (var effect in effects)
        {
            <option value="@effect">@effect</option>
        }
    </select>
</div>
<button class="btn btn-primary" @onclick="SetEffect">Set Effect</button>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <p>@statusMessage</p>
}

